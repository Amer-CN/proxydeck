  "comparison_exemptions": [
    "ccKeyMapSet 的 JSON 解析错误文案（Go encoding/json 与 serde_json 的报错文本不可能逐字相同）：仅该步的 msg 归一为 $JSONERR",
    "appdir.log（ACL 收紧失败时的诊断日志）：带时间戳且内容取决于 icacls 是否在 PATH 上，不作黄金",
    "PDAPI1 密文文件的字节：DPAPI 每次调用产出不同，按「能否解回同一明文」比较（见 files 的 protected 语义）",
    "ccLiveSnapshot 的取值：随本机各插件端口实时状态变化，只比键集与 ok 形状"
  ],
  "core_version": "v1.2.0",
  "normalization": [
    "\u003cexe 路径\u003e → $EXE",
    "\u003cPROXYDECK_DATA_DIR 临时目录\u003e → $DATA",
    "\u003cAPPDATA 临时目录\u003e → $APPDATA",
    "127.0.0.1:\u003c测试端口\u003e → 127.0.0.1:$PORT",
    "\"port\":\"\u003cn\u003e\" → \"port\":\"$PORT\"",
    "-port \u003cn\u003e → -port $PORT（自启 VBS 的命令行）",
    "\"pid\":\u003cn\u003e → \"pid\":0",
    "\"uptime\":\u003cn\u003e → \"uptime\":0"
  ],

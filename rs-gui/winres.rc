// winres.rc -- rs-gui.exe Windows resource manifest (P7d-2).
//
// Compiled into the exe by `rs-gui/build.rs` through `embed-resource`:
//   * icon    -- `rs-gui/icon.ico` (byte-identical copy of `app/icon.ico`;
//                build.rs fails the build if the two ever drift apart)
//   * version -- `version.rc` (VERSIONINFO; digit values must match
//                `rs-gui/src/lib.rs::APP_VERSION`; `tests/winres_contract.rs`
//                enforces that both at test time and at build time)
//
// THE RESOURCE ID MUST BE 1. `src/win32.rs::set_window_icon` calls
// `LoadIconW(hInst, MAKEINTRESOURCE(1))` and `src/tray.rs::tray_icon_handle`
// calls `LoadImageW(hInst, MAKEINTRESOURCE(1), IMAGE_ICON, ...)` -- same as Go
// `app/platform_windows.go:63` (`LoadIconW(hInst, 1)`; Go's resource comes from
// `app/resource.syso`, also id 1). Any other id = no icon for the window and no
// icon in the tray (`LoadIconW` returns 0 and the code silently falls back to
// the system default icon).
//
// THIS FILE IS ASCII ONLY. rc.exe picks the code page of the generated .res
// from the environment, so non-ASCII bytes in a .rc are a risk (same family as
// pitfall 13 in the repo CLAUDE.md). Non-ASCII product text belongs in
// Cargo.toml, not here. `tests/winres_contract.rs` asserts this file and
// version.rc are pure ASCII.

// Version info (UTF-16 string block generated by rc.exe)
#include "version.rc"

// Icon, id = 1 (see above)
1 ICON "icon.ico"
